# Build output. Generated fresh on push and deployed to Pages, never committed.
/site/

# A self-hosted Pyodide, the escape hatch tools/fetch_pyodide.py populates
# if the CDN assets/sql-cell.js defaults to turns out to be blocked. Not
# committed, the same as dewlab's own equivalent.
/assets/vendor/pyodide/

# Python bytecode.
__pycache__/
*.py[cod]
.pytest_cache/

# Editors and operating systems.
.DS_Store

# Git worktrees the harness creates for background agents (each one is a
# .git pointer file, not real content — the actual work lands as commits on
# its own branch instead).
/.claude/worktrees/
